# ChicagoPulse environment variable NAMES only. Never commit real values.
# Copy to app/.env for local development.

# --- Runtime ---
# "development" | "production". Production refuses to start if MOCK_MODE=true.
ENVIRONMENT=development
# Serve deterministic local fixtures instead of calling Databricks. Dev/test only.
MOCK_MODE=true

# --- Databricks connection (local dev) ---
# Locally, auth is provided by the Databricks CLI profile below.
# In the deployed app these arrive via App resource bindings instead.
DATABRICKS_HOST=
DATABRICKS_PROFILE=chicagopulse

# --- Resource identifiers (bound via valueFrom in app.yaml when deployed) ---
GENIE_SPACE_ID=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_JOB_ID=

# --- Unity Catalog namespace for governed Gold tables / Metric Views ---
CATALOG=workspace
SCHEMA_NAME=chicagopulse
