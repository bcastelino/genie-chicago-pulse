# Vite variables are embedded into the browser bundle. Never put secrets here.
# Local development and Databricks Apps need no frontend environment file.
VITE_DEPLOYMENT_TARGET=databricks
VITE_API_BASE_URL=

# Appwrite Sites production example:
# VITE_DEPLOYMENT_TARGET=appwrite
# VITE_API_BASE_URL=https://<function-id>.<region>.appwrite.run
