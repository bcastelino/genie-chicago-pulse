# Appwrite Function variables only. Never expose these values to the Site build.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_APP_URL=https://<app-name>-<workspace-id>.aws.databricksapps.com
ALLOWED_ORIGINS=https://<site-id>.appwrite.network

# Default and recommended production value. Valid range: 1-25 seconds.
UPSTREAM_TIMEOUT_SECONDS=20
